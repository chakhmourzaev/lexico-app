{"title": "Chanson d'automne", "author": "Paul Verlaine", "n": 1, "lines": ["Les sanglots longs", "Des violons", "De l'automne", "Blessent mon cœur", "D'une langueur", "Monotone.", "Tout suffocant", "Et blême, quand", "Sonne l'heure,", "Je me souviens", "Des jours anciens", "Et je pleure ;", "Et je m'en vais", "Au vent mauvais", "Qui m'emporte", "Deçà, delà,", "Pareil à la", "Feuille morte."], "words": [[0, "Les", "l e"], [0, "sanglots", "s ɑ̃ ɡ l o"], [0, "longs", "l ɔ̃"], [1, "Des", "d e"], [1, "violons", "v j o l ɔ̃"], [2, "De", "d ə"], [2, "l'automne", "l o t ɔ n"], [3, "Blessent", "b l ɛ s"], [3, "mon", "m ɔ̃"], [3, "cœur", "k œ ʁ"], [4, "D'une", "d y n"], [4, "langueur", "l ɑ̃ ɡ œ ʁ"], [5, "Monotone", "m o n o t ɔ n"], [6, "Tout", "t u"], [6, "suffocant", "s y f o k ɑ̃"], [7, "Et", "e"], [7, "blême", "b l ɛ m"], [7, "quand", "k ɑ̃"], [8, "Sonne", "s ɔ n"], [8, "l'heure", "l œ ʁ"], [9, "Je", "ʒ ə"], [9, "me", "m ə"], [9, "souviens", "s u v j ɛ̃"], [10, "Des", "d e"], [10, "jours", "ʒ u ʁ"], [10, "anciens", "ɑ̃ s j ɛ̃"], [11, "Et", "e"], [11, "je", "ʒ ə"], [11, "pleure", "p l œ ʁ"], [12, "Et", "e"], [12, "je", "ʒ ə"], [12, "m'en", "m ɑ̃"], [12, "vais", "v ɛ"], [13, "Au", "o"], [13, "vent", "v ɑ̃"], [13, "mauvais", "m o v ɛ"], [14, "Qui", "k i"], [14, "m'emporte", "m ɑ̃ p ɔ ʁ t"], [15, "Deçà", "d ə s a"], [15, "delà", "d ə l a"], [16, "Pareil", "p a ʁ ɛ j"], [16, "à", "a"], [16, "la", "l a"], [17, "Feuille", "f œ j"], [17, "morte", "m ɔ ʁ t"]]},
{"title": "Demain, dès l'aube", "author": "Victor Hugo", "n": 2, "lines": ["Demain, dès l'aube, à l'heure où blanchit la campagne,", "Je partirai. Vois-tu, je sais que tu m'attends.", "J'irai par la forêt, j'irai par la montagne.", "Je ne puis demeurer loin de toi plus longtemps.", "Je marcherai les yeux fixés sur mes pensées,", "Sans rien voir au dehors, sans entendre aucun bruit,", "Seul, inconnu, le dos courbé, les mains croisées,", "Triste, et le jour pour moi sera comme la nuit.", "Je ne regarderai ni l'or du soir qui tombe,", "Ni les voiles au loin descendant vers Harfleur,", "Et quand j'arriverai, je mettrai sur ta tombe", "Un bouquet de houx vert et de bruyère en fleur."], "words": [[0, "Demain", "d ə m ɛ̃"], [0, "dès", "d ɛ"], [0, "l'aube", "l o b"], [0, "à", "a"], [0, "l'heure", "l œ ʁ"], [0, "où", "u"], [0, "blanchit", "b l ɑ̃ ʃ i"], [0, "la", "l a"], [0, "campagne", "k ɑ̃ p a ɲ"], [1, "Je", "ʒ ə"], [1, "partirai", "p a ʁ t i ʁ e"], [1, "Vois-tu", "v w a t y"], [1, "je", "ʒ ə"], [1, "sais", "s ɛ"], [1, "que", "k ə"], [1, "tu", "t y"], [1, "m'attends", "m a t ɑ̃"], [2, "J'irai", "ʒ i ʁ e"], [2, "par", "p a ʁ"], [2, "la", "l a"], [2, "forêt", "f o ʁ ɛ"], [2, "j'irai", "ʒ i ʁ e"], [2, "par", "p a ʁ"], [2, "la", "l a"], [2, "montagne", "m ɔ̃ t a ɲ"], [3, "Je", "ʒ ə"], [3, "ne", "n ə"], [3, "puis", "p y i"], [3, "demeurer", "d ə m ø ʁ e"], [3, "loin", "l w ɛ̃"], [3, "de", "d ə"], [3, "toi", "t w a"], [3, "plus", "p l y"], [3, "longtemps", "l ɔ̃ t ɑ̃"], [4, "Je", "ʒ ə"], [4, "marcherai", "m a ʁ ʃ ʁ e"], [4, "les", "l e"], [4, "yeux", "j ø"], [4, "fixés", "f i k s e"], [4, "sur", "s y ʁ"], [4, "mes", "m e"], [4, "pensées", "p ɑ̃ s e"], [5, "Sans", "s ɑ̃"], [5, "rien", "ʁ i ɛ̃"], [5, "voir", "v w a ʁ"], [5, "au", "o"], [5, "dehors", "d ə ɔ ʁ"], [5, "sans", "s ɑ̃"], [5, "entendre", "ɑ̃ t ɑ̃ d ʁ"], [5, "aucun", "o k œ̃"], [5, "bruit", "b ʁ y i"], [6, "Seul", "s œ l"], [6, "inconnu", "ɛ̃ k ɔ n y"], [6, "le", "l ə"], [6, "dos", "( e n ) d ɒ s ( f r )"], [6, "courbé",